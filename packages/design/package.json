{
  "name": "@cnd.sh/design",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "files": [
    "build"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "module": "./build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./components": {
      "types": "./build/components/index.d.ts",
      "import": "./build/components/index.js",
      "default": "./build/components/index.js"
    },
    "./layouts": {
      "types": "./build/layouts/index.d.ts",
      "import": "./build/layouts/index.js",
      "default": "./build/layouts/index.js"
    },
    "./utils": {
      "types": "./build/utils/index.d.ts",
      "import": "./build/utils/index.js",
      "default": "./build/utils/index.js"
    },
    "./styles.css": "./build/styles.css"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bundle": "tsc -p tsconfig.build.json && cp src/styles.css build/styles.css",
    "fix": "biome check --write --unsafe .",
    "lint": "biome check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
